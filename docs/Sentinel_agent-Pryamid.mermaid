graph TD

    %% ─────────────────────────────────────────────
    %% SENTINEL AGENT PYRAMID
    %% ─────────────────────────────────────────────
    S0[Sentinel Agent<br/>Apex Intent]
    S1[Rule Anchor<br/>RAFCP Constraint Field]
    S2[Shell Protocol<br/>Boundary Conditions]
    S3[TVJP Stack<br/>Temporal–Vector–Judgment–Priority]
    S4[RAFCP Action Filter<br/>Pre‑Execution Screening]
    S5[Field Coherence<br/>Beacon Topology]
    S6[Collapse Handler<br/>Failover / Contradiction Resolution]
    S7[Pulse Sync<br/>Cluster Health Rhythm]
    S8[Cold Vault Isolation<br/>Containment]

    S0 --> S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S8


