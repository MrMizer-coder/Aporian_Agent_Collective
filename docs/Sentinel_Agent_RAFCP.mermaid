graph TD
    %% Aporian Pyramidal Reasoning – Agent Collective (Depth Stack)

    %% Level 0 – Apex Intent
    A0[Sentinel Agent\n(Apex Intent)]:::sentinel

    %% Level 1 – Rule Anchor Layer
    A1[Rule Anchor\nRAFCP Constraint Field]:::govern
    A0 --> A1

    %% Level 2 – Shell Protocol Layer
    A2[Shell Protocol\nSentinelOps Shell / Boundary Conditions]:::shell
    A1 --> A2

    %% Level 3 – TVJP Layer
    A3[TVJP Stack\n(Temporal–Vector–Judgment–Priority)]:::tvjp
    A2 --> A3

    %% Level 4 – RAFCP Action Filter
    A4[RAFCP Action Filter\nPre‑Execution Screening]:::rafcp
    A3 --> A4

    %% Level 5 – Field Coherence
    A5[Field Coherence\nGlobal Beacon Topology]:::coherence
    A4 --> A5

    %% Level 6 – Collapse Handler
    A6[Collapse Handler\nFailover / Contradiction Resolution]:::collapse
    A5 --> A6

    %% Level 7 – Pulse Sync
    A7[Pulse Sync\nCluster Health Rhythm]:::pulse
    A6 --> A7

    %% Level 8 – Cold Vault Isolation
    A8[Cold Vault Isolation\nContainment of Violations]:::isolation
    A7 --> A8

    %% Styling
    classDef sentinel fill:#111,stroke:#fff,stroke-width:1px,color:#fff;
    classDef govern fill:#222,stroke:#fff,stroke-width:1px,color:#fff;
    classDef shell fill:#333,stroke:#fff,stroke-width:1px,color:#fff;
    classDef tvjp fill:#444,stroke:#fff,stroke-width:1px,color:#fff;
    classDef rafcp fill:#555,stroke:#fff,stroke-width:1px,color:#fff;
    classDef coherence fill:#666,stroke:#fff,stroke-width:1px,color:#fff;
    classDef collapse fill:#777,stroke:#fff,stroke-width:1px,color:#fff;
    classDef pulse fill:#888,stroke:#fff,stroke-width:1px,color:#fff;
    classDef isolation fill:#000,stroke:#fff,stroke-width:1px,color:#fff;
